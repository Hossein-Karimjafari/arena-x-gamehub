# Postgres (Neon): از پنل neon.tech کپی کنید — باید ?sslmode=require داشته باشد
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-generate-a-long-random-string-min-16-chars"
NEXT_PUBLIC_SITE_NAME="گیم‌نت آرنا ایکس"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_PHONE="021-91000000"
NEXT_PUBLIC_MOBILE="09121234567"
NEXT_PUBLIC_ADDRESS="تهران، خیابان ولیعصر، بالاتر از پارک ساعی، پلاک ۲۴"

# Zarinpal payment gateway (optional).
# Leave empty to use the built-in sandbox simulator (/pay/simulate).
ZARINPAL_MERCHANT_ID=""

# OAuth (optional) — requires a Prisma adapter + Account model to work with credentials accounts.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
